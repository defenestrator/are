APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated IPs/CIDRs of any load balancer or CDN in front of the app,
# so request()->ip() (and per-IP rate limits) see the real client. Leave
# empty when nothing proxies the app. See config/trustedproxy.php.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Private disk for music catalogue tracks and stems (config/music.php).
MUSIC_DISK=local
# Largest track or stems upload in KB (200 MB). PHP upload_max_filesize,
# post_max_size and nginx client_max_body_size must allow at least this much.
MUSIC_MAX_UPLOAD_KB=204800
# Songs one person may have waiting in the !song queue at once.
MUSIC_REQUESTS_PER_USER=2
# Twitch custom reward ids whose redemptions become song requests, one per
# channel, comma-separated (empty = off). Create them with
# `php artisan music:create-song-reward` so refused requests can be refunded.
MUSIC_SONG_REQUEST_REWARD_ID=
# Local: database. Production (Forge): redis, which Horizon requires.
QUEUE_CONNECTION=database

# Local: database. Production (Forge): redis.
CACHE_STORE=database
# CACHE_PREFIX=are_cache_

MEMCACHED_HOST=127.0.0.1

# Production: phpredis if `php -m` lists redis, otherwise predis (needs predis/predis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Production: the server's real Redis password (the Redis there is password-protected).
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production Redis is shared with other apps on the low indexes, so ARE uses its
# own. cache:clear runs FLUSHDB on REDIS_CACHE_DB, so it must never equal REDIS_DB
# or another app's index. Queue, Horizon and locks use REDIS_DB.
REDIS_DB=4
REDIS_CACHE_DB=5
# Key prefixes default to are_database_, are_cache_ and are_horizon:, whatever APP_NAME is.
# REDIS_PREFIX=are_database_
# HORIZON_PREFIX=are_horizon:
# Keep above every Horizon supervisor timeout (config/horizon.php), or jobs can run twice.
# REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Generate with: php artisan reverb:install (fresh values for production, never reuse local ones).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where Laravel sends broadcasts and Echo connects (the public address).
REVERB_HOST="localhost"              # production: ws.<domain>
REVERB_PORT=8080                     # production: 443
REVERB_SCHEME=http                   # production: https
# Where the daemon binds (not the public address).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080              # production: the port given to Forge's Reverb toggle
REVERB_SCALING_ENABLED=false
# Hostnames allowed to open a socket, comma separated. Defaults to the APP_URL host.
REVERB_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TWITCH_CLIENT_ID="NO! U!"
TWITCH_CLIENT_SECRET="NO! U!"
# Register both callback URLs in the Twitch developer console.
TWITCH_REDIRECT_URL="${APP_URL}/twitch/auth"
TWITCH_BROADCASTER_REDIRECT_URL="${APP_URL}/twitch/broadcaster/callback"
# Primary channel (Twitch user id), plus any other channels this app serves, comma separated.
TWITCH_CHANNEL_ID="NO! U!"
TWITCH_BROADCASTER_IDS=
# Channels whose subscribers also count as subscribers here, comma separated.
TWITCH_FRIEND_IDS=
# Generate with: php artisan twitch:generate-event-sub-key
TWITCH_HELIX_EVENTSUB_SECRET=
# Defaults to ${APP_URL}/twitch/eventsub; must be public HTTPS on port 443.
TWITCH_EVENTSUB_CALLBACK_URL=

# YouTube Live Chat (#24). An API key restricted to YouTube Data API v3 and this server's IP.
YOUTUBE_API_KEY=
# The YouTube channel ids (UC...) whose live chat ARE reads, comma separated.
YOUTUBE_CHANNEL_IDS=
YOUTUBE_POLL_FLOOR_MS=3000
YOUTUBE_QUOTA_DAILY_UNITS=10000
YOUTUBE_QUOTA_DAILY_SEARCH_CALLS=100
YOUTUBE_QUOTA_ALERT_RATIO=0.8
# Chat replies on YouTube (#110): a Google OAuth client (Web application). Channel owners connect at /youtube/broadcaster/connect.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL="${APP_URL}/youtube/broadcaster/callback"
CHAT_REPLIES_YOUTUBE=false
CHAT_REPLIES_YOUTUBE_PER_STREAM=40

# Chat commands (!q, !vote) one person may run per minute, across all platforms.
CHAT_COMMANDS_PER_MINUTE=10

# !clip (#11): markers per channel per minute, seconds to wait before cutting
# the clip, and the assumed lifetime of a clip download URL (Twitch gives none).
CLIPS_PER_CHANNEL_PER_MINUTE=5
CLIPS_CREATE_DELAY_SECONDS=30
CLIPS_DOWNLOAD_URL_TTL_SECONDS=1800
# Where fetched clip MP4s are kept. Must be a private disk ("local" is
# storage/app/private); mods play them through /clips only.
CLIPS_DISK=local
CLIPS_MAX_FILE_BYTES=314572800
CLIPS_DOWNLOAD_HOSTS=twitchcdn.net,twitch.tv,jtvnw.net

# Chat Control Bus (#9, /bus). BUS_ENABLED=false is a deploy-time off switch;
# moderators pause and kill it at runtime. BUS_PLATFORMS lists the platforms
# whose chat feeds it: windows stretch by the slowest one's BUS_LATENCY_*.
BUS_ENABLED=true
BUS_PLATFORMS=twitch
BUS_LATENCY_TWITCH=3
BUS_LATENCY_YOUTUBE=12
BUS_LATENCY_FACEBOOK=10
BUS_ORKESTERA_MODE=democracy
BUS_ORKESTERA_WINDOW_SECONDS=60
# Free-text actions wait this long for a moderator on /bus, then are rejected.
BUS_APPROVAL_TIMEOUT_SECONDS=120
# The kill switch voids actions not yet delivered, and those delivered this recently.
BUS_KILL_UNDO_SECONDS=300

# OBS overlays (/overlay/*). Issue each overlay's URL with: php artisan overlay:token <overlay>
# The token rides in the URL fragment (#token=) and is traded for a grant cookie lasting this long.
ARE_OVERLAY_GRANT_SECONDS=120
# Old ?token= URLs work for one release, logging a deprecation warning. Set false once OBS is moved over.
ARE_OVERLAY_ALLOW_QUERY_TOKEN=true
# Call-to-action lower-third: an item with no URL is not shown. Copy lives in config/are.php.
ARE_CTA_ROTATE_SECONDS=15
ARE_CTA_ORKESTERA_URL=
ARE_CTA_ORKESTERA_DISPLAY_URL=
ARE_CTA_EDOS_URL=
ARE_CTA_EDOS_DISPLAY_URL=

# Who is told about /about enquiries (sent from the queue). Comma-separated emails.
ARE_LEADS_NOTIFY=
# Optional Slack or Discord incoming webhook. Its message carries no personal data.
ARE_LEADS_WEBHOOK_URL=
# Weekly attribution summary (aggregates only), Mondays 09:00 app time by default.
# The webhook defaults to ARE_LEADS_WEBHOOK_URL. Day: 0 = Sunday ... 6 = Saturday.
ARE_WEEKLY_SUMMARY_WEBHOOK_URL=
ARE_WEEKLY_SUMMARY_DAY=1
ARE_WEEKLY_SUMMARY_TIME=09:00

# !orkestera and !edos chat commands: where their tracked links point (a /path or
# an http(s) URL), and how often each may answer per channel. Copy is in config/are.php.
ARE_CHAT_ORKESTERA_URL="/about#orkestera"
ARE_CHAT_EDOS_URL="/about#work-with-us"
ARE_CHAT_LINK_COOLDOWN_SECONDS=30
