includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    # Keep the result cache inside this checkout (gitignored by
    # storage/framework/cache/.gitignore). The default, the system temp
    # directory, is shared by every worktree, which then see each other's results.
    tmpDir: %currentWorkingDirectory%/storage/framework/cache/phpstan

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
